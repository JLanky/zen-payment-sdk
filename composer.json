{
  "name" : "jlanky/zen-payments-sdk",
  "description" : "This package allows communication with zen.com payment API",
  "type" : "library",
  "keywords" : [
    "Zen",
    "API",
    "SDK",
    "PHP",
    "Payments",
    "Zen.com"
  ],
  "license" : "MIT",
  "homepage": "https://github.com/JLanky/zen-payments-sdk",
  "authors" : [],
  "support" : {
    "email" : "lanky@i.ua"
  },
  "require" : {
    "php": "8.1.* | 8.2.*",
    "symfony/dotenv": "^6.4",
    "symfony/dependency-injection": "^6.4",
    "symfony/validator": "^6.4",
    "symfony/serializer": "^6.4",
    "symfony/property-info": "^6.4",
    "symfony/property-access": "^6.4",
    "symfony/intl": "^6.4"
  },
  "require-dev" : {
    "nyholm/psr7": "^1.5",
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.65",
    "symfony/var-dumper": "^6.0",
    "phpunit/phpunit": "^10.5",
    "symfony/http-client": "^6.4",
    "psr/http-client": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "JLanky\\ZenPayments\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JLanky\\ZenPayments\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "fix": "php-cs-fixer fix",
    "check-style": "php-cs-fixer fix --dry-run --diff"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
